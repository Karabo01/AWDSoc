# api + worker
DATABASE_URL=postgresql+asyncpg://awdsoc:awdsoc@postgres:5432/awdsoc
REDIS_URL=redis://redis:6379/0
# api and worker each hold their own pool. On an 8 GB host use 5/5.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
ENVIRONMENT=production

# One image, two roles. `api` serves HTTP; `worker` runs the ingest consumer,
# partition maintenance and reprocess jobs. Set APP_ROLE=worker on the worker
# resource - a worker that boots as a second API looks healthy while nothing
# ever writes alerts to Postgres.
APP_ROLE=api

# Public origin of the console. This is what goes into every client's
# integration block, so a wrong value breaks onboarding silently.
CONSOLE_BASE_URL=https://soc.awdtech.co.za

JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# 32 bytes base64, for Wazuh credentials: python -m app.cli generate-key
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# First-run administrator. Only applied when the users table is empty, so it is
# inert on an initialised deployment. Leave the password blank to have one
# generated and printed once in the api logs. Remove both after signing in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Admin

INGEST_MAX_SKEW_SECONDS=300
INGEST_RATE_LIMIT_PER_TENANT=500/second
INGEST_MAX_BATCH=500
INGEST_MAX_BODY_BYTES=4194304
# Number of trusted proxies in front of the API. Traefik alone = 1.
INGEST_TRUSTED_PROXY_HOPS=1
INGEST_STREAM_KEY=awdsoc:alerts
INGEST_STREAM_MAXLEN=1000000
ALERT_RETENTION_DAYS=90
NORMALISATION_MAP_VERSION=1
WAZUH_SYNC_INTERVAL=300
