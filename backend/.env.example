# api + worker
DATABASE_URL=postgresql+asyncpg://awdsoc:awdsoc@postgres:5432/awdsoc
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=production

JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# 32 bytes base64, for Wazuh credentials: python -m app.cli generate-key
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

INGEST_MAX_SKEW_SECONDS=300
INGEST_RATE_LIMIT_PER_TENANT=500/second
ALERT_RETENTION_DAYS=90
NORMALISATION_MAP_VERSION=1
WAZUH_SYNC_INTERVAL=300
